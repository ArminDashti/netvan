<?xml version="1.0" encoding="UTF-8"?>
<!-- WinSW helper for netvan-api. install.ps1 rewrites executable/env from live paths. -->
<service>
  <id>netvan-api</id>
  <name>netvan-api</name>
  <description>netvan API (local Windows)</description>
  <executable>C:\Users\armin\GitHub\netvan\netvan-api\target\release\netvan-api.exe</executable>
  <arguments>run</arguments>
  <workingdirectory>C:\Users\armin\GitHub\netvan\netvan-api</workingdirectory>
  <env name="NETVAN_API_BIND" value="127.0.0.1:8000"/>
  <env name="NETVAN_API_DATA_DIR" value="C:\ProgramData\Netvan\NetvanApi"/>
  <logmode>rotate</logmode>
  <onfailure action="restart" delay="10 sec"/>
</service>
