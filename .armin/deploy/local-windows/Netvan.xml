<?xml version="1.0" encoding="UTF-8"?>
<service>
  <id>Netvan</id>
  <name>Netvan</name>
  <description>netvan API + WebUI (local Windows)</description>
  <executable>C:\WINDOWS\System32\WindowsPowerShell\v1.0\powershell.exe</executable>
  <arguments>-NoProfile -ExecutionPolicy Bypass -File &quot;C:\Users\armin\GitHub\netvan\.armin\deploy\local-windows\Start-Netvan.ps1&quot; -ApiExe &quot;C:\Users\armin\GitHub\netvan\netvan-api\target\x86_64-pc-windows-msvc\release\netvan-api.exe&quot; -ApiWorkingDir &quot;C:\Users\armin\GitHub\netvan\netvan-api&quot; -WebUiRoot &quot;C:\Users\armin\GitHub\netvan\netvan-webui\dist&quot; -ServeScript &quot;C:\Users\armin\GitHub\netvan\.armin\deploy\local-windows\Serve-WebUi.ps1&quot; -DataDir &quot;C:\ProgramData\Netvan\NetvanApi&quot; -ApiPort 28100 -WebUiPort 28101 -BindHost 127.0.0.1</arguments>
  <workingdirectory>C:\Users\armin\GitHub\netvan\.armin\deploy\local-windows</workingdirectory>
  <env name="NETVAN_API_BIND" value="127.0.0.1:28100"/>
  <env name="NETVAN_API_DATA_DIR" value="C:\ProgramData\Netvan\NetvanApi"/>
  <logpath>C:\ProgramData\Netvan\NetvanApi</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec"/>
  <stoptimeout>20 sec</stoptimeout>
</service>